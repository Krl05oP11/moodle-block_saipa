{{!
    @template block_saipa/chat_widget

    SAIPA chat widget — Telegram and WhatsApp linking panels (v0.4.1).

    Context variables:
    - courseid: int
    - userid: int
    - username: string
    - wwwroot: string
    - is_teacher: bool
    - telegram_enabled: bool
    - telegram_linked: bool
    - telegram_username: string
    - whatsapp_enabled: bool
    - whatsapp_verified: bool
    - whatsapp_phone: string  (masked, e.g. ****5678)
}}
<div id="saipa-widget-{{courseid}}" class="saipa-chat-widget" data-courseid="{{courseid}}" data-userid="{{userid}}">
    <div class="saipa-chat-header d-flex align-items-center p-2 bg-primary text-white rounded-top">
        <span class="mr-2">&#129302;</span>
        <strong>{{#str}} chat_title, block_saipa {{/str}}</strong>
    </div>
    <div id="saipa-messages-{{courseid}}" class="saipa-chat-messages p-2"
         style="height:220px;overflow-y:auto;background:#f8f9fa;border:1px solid #dee2e6;">
        <div class="text-muted small text-center pt-4">
            {{#str}} chat_placeholder, block_saipa {{/str}}
        </div>
    </div>
    <div class="saipa-chat-input input-group p-1 border border-top-0 rounded-bottom">
        <input type="text"
               id="saipa-input-{{courseid}}"
               class="form-control form-control-sm"
               placeholder="{{#str}} chat_placeholder, block_saipa {{/str}}"
               aria-label="{{#str}} chat_placeholder, block_saipa {{/str}}">
        <div class="input-group-append">
            <button class="btn btn-primary btn-sm" id="saipa-send-{{courseid}}" type="button">
                {{#str}} chat_send, block_saipa {{/str}}
            </button>
        </div>
    </div>
    {{#is_teacher}}
    <div class="saipa-index-section p-2 border-top" id="saipa-index-{{courseid}}">
        <div class="d-flex justify-content-between align-items-center">
            <button class="btn btn-outline-secondary btn-sm" id="saipa-index-btn-{{courseid}}" type="button">
                &#128196; {{#str}} index_button, block_saipa {{/str}}
            </button>
            <a href="{{wwwroot}}local/saipa/teacher.php?courseid={{courseid}}"
               class="btn btn-outline-primary btn-sm">
                &#128101; {{#str}} teacher_dashboard_link, block_saipa {{/str}}
            </a>
        </div>
        <div id="saipa-index-status-{{courseid}}" class="small text-muted mt-1"></div>
    </div>
    {{/is_teacher}}

    {{#telegram_enabled}}
    <div class="saipa-telegram-section p-2 border-top" id="saipa-telegram-{{courseid}}">
        <div class="d-flex align-items-center mb-1">
            <span style="font-size:1.1em;">&#x1F4F1;</span>
            <strong class="ml-1 small">{{#str}} telegram_panel_title, block_saipa {{/str}}</strong>
        </div>
        {{^telegram_linked}}
        <p class="small text-muted mb-1">{{#str}} telegram_link_desc, block_saipa {{/str}}</p>
        <div id="saipa-tg-actions-{{courseid}}">
            <button class="btn btn-outline-primary btn-sm btn-block" id="saipa-tg-link-btn-{{courseid}}" type="button">
                {{#str}} telegram_link_button, block_saipa {{/str}}
            </button>
            <div id="saipa-tg-status-{{courseid}}" class="small text-muted mt-1" style="display:none;"></div>
        </div>
        {{/telegram_linked}}
        {{#telegram_linked}}
        <div class="d-flex justify-content-between align-items-center">
            <span class="small text-success">
                &#x2705; {{#str}} telegram_linked_as, block_saipa, {{telegram_username}} {{/str}}
            </span>
            <button class="btn btn-outline-danger btn-sm" id="saipa-tg-unlink-btn-{{courseid}}" type="button">
                {{#str}} telegram_unlink_button, block_saipa {{/str}}
            </button>
        </div>
        {{/telegram_linked}}
    </div>
    {{/telegram_enabled}}

    {{#whatsapp_enabled}}
    <div class="saipa-whatsapp-section p-2 border-top" id="saipa-wa-{{courseid}}">
        <div class="d-flex align-items-center mb-1">
            <span style="font-size:1.1em;">&#x1F4AC;</span>
            <strong class="ml-1 small">{{#str}} whatsapp_panel_title, block_saipa {{/str}}</strong>
        </div>
        {{^whatsapp_verified}}
        <p class="small text-muted mb-1">{{#str}} whatsapp_link_desc, block_saipa {{/str}}</p>
        {{! Step 1: phone input }}
        <div id="saipa-wa-step1-{{courseid}}">
            <div class="input-group input-group-sm mb-1">
                <input type="tel"
                       id="saipa-wa-phone-{{courseid}}"
                       class="form-control"
                       placeholder="{{#str}} whatsapp_phone_placeholder, block_saipa {{/str}}"
                       aria-label="{{#str}} whatsapp_phone_label, block_saipa {{/str}}">
                <div class="input-group-append">
                    <button class="btn btn-outline-success btn-sm" id="saipa-wa-send-btn-{{courseid}}" type="button">
                        {{#str}} whatsapp_send_otp_button, block_saipa {{/str}}
                    </button>
                </div>
            </div>
            <div id="saipa-wa-step1-msg-{{courseid}}" class="small text-muted"></div>
        </div>
        {{! Step 2: OTP input (hidden until OTP is sent) }}
        <div id="saipa-wa-step2-{{courseid}}" style="display:none;">
            <div class="input-group input-group-sm mb-1">
                <input type="text"
                       id="saipa-wa-otp-{{courseid}}"
                       class="form-control"
                       maxlength="6"
                       placeholder="------"
                       aria-label="{{#str}} whatsapp_otp_label, block_saipa {{/str}}">
                <div class="input-group-append">
                    <button class="btn btn-success btn-sm" id="saipa-wa-confirm-btn-{{courseid}}" type="button">
                        {{#str}} whatsapp_confirm_button, block_saipa {{/str}}
                    </button>
                </div>
            </div>
            <div id="saipa-wa-step2-msg-{{courseid}}" class="small text-muted"></div>
        </div>
        {{/whatsapp_verified}}
        {{#whatsapp_verified}}
        <div class="d-flex justify-content-between align-items-center">
            <span class="small text-success">
                &#x2705; {{#str}} whatsapp_verified_as, block_saipa, {{whatsapp_phone}} {{/str}}
            </span>
            <button class="btn btn-outline-danger btn-sm" id="saipa-wa-unlink-btn-{{courseid}}" type="button">
                {{#str}} whatsapp_unlink_button, block_saipa {{/str}}
            </button>
        </div>
        {{/whatsapp_verified}}
    </div>
    {{/whatsapp_enabled}}
</div>
{{#js}}
require(['block_saipa/chat'], function(Chat) {
    Chat.init({{courseid}}, '{{wwwroot}}');
});
{{#is_teacher}}
require(['block_saipa/index'], function(Index) { Index.init({{courseid}}); });
{{/is_teacher}}
{{#telegram_enabled}}
require(['block_saipa/telegram'], function(Telegram) {
    Telegram.init({{courseid}}, {{#telegram_linked}}true{{/telegram_linked}}{{^telegram_linked}}false{{/telegram_linked}});
});
{{/telegram_enabled}}
{{#whatsapp_enabled}}
require(['block_saipa/whatsapp'], function(WhatsApp) {
    WhatsApp.init({{courseid}}, {{#whatsapp_verified}}true{{/whatsapp_verified}}{{^whatsapp_verified}}false{{/whatsapp_verified}});
});
{{/whatsapp_enabled}}
{{/js}}
